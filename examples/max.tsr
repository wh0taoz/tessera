# Two holes in return statements: both must be ints (the return type).
# A good guesser should pick different values for the two branches.
def max(int a, int b) -> int {
    if (a < b) {
        return ?then_branch;
    } else {
        return ?else_branch;
    }
}

def main() -> int {
    return max(3, 4);
}
